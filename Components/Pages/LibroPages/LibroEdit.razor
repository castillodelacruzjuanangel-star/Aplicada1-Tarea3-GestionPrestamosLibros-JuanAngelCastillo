@page "/Libro/Edit/{LibroId:int}"
@rendermode InteractiveServer
@inject LibroServices libroServices
@inject NavigationManager navigation
@inject ToastService toastService

<PageTitle>Editar libro</PageTitle>
<EditForm Model="libro" OnValidSubmit="Modificar" FormName="modificarLibro" method="post">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">EDITAR DATOS DEL LIBRO</h5>
            </div>
 
            <div class="card shadow">

                <div class="mb-3">
                    <label class="form-label">ID</label>
                    <InputNumber class="form-control" @bind-Value="libro.LibroId" readonly></InputNumber>
                </div>

                <div class="mb-3">
                    <label class="form-label">Titulo</label>
                    <InputText class="form-control" @bind-Value="libro.Titulo"></InputText>
                    <ValidationMessage For="@(() => libro.Titulo)"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Autor</label>
                    <InputText class="form-control" @bind-Value="libro.Autor"></InputText>
                    <ValidationMessage For="@(() => libro.Autor)"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Año de publicacion</label>
                    <InputNumber class="form-control" @bind-Value="libro.AnoPublicacion"></InputNumber>
                    <ValidationMessage For="@(() => libro.AnoPublicacion)"/>
                </div>

            </div>

            <div class="card-footer text-center mt-2">
                <a href="/Libro/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-success bi bi-floppy"> Guardar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="Modal" data-bs-target="#ModalEliminar"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="ModalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalEliminar">¿Esta seguro que desea eliminar el libro?</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label class="form-label">Al eliminar, el libro se borrara permanentemente</label>
            </div>
            <div class="modal-footer">
                <a href="/Prestamo/Index" class="btn btn-secondary">Volver</a>
                <button type="button" class="btn btn-danger bi bi-trash" @onclick="Eliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code{

    [Parameter]
    public int libroId{get; set;}
    public Libro libro{get; set;} = new Libro();
    public List<Libro>listaLibros{get; set;} = [];

    protected override async Task OnInitializedAsync()
    {
        libro = await libroServices.Buscar(libroId) ?? new Libro();
        listaLibros = await libroServices.GetList(l => l.LibroId > 0);
    }

    public async Task Modificar()
    {
        var modificado = await libroServices.Guardar(libro);
        if (modificado)
        {
            navigation.NavigateTo("/Libro/Index");
        }
        else
        {
            toastService.ShowError("No se pudo modificar los datos del libro.");
        }
    }

    public async Task Eliminar()
    {
        var eliminado = await libroServices.Eliminar(libroId);
        if (eliminado)
        {
            navigation.NavigateTo("/Libro/Index");
        }
        else
        {
            toastService.ShowError("Ocurrio un error al eliminar el libro");            
        }
    }
}