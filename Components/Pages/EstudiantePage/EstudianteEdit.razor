@page "/Estudiante/Edit/{EstudianteId:int}"
@rendermode InteractiveServer
@inject EstudianteServices estudianteServices
@inject NavigationManager navigation
@inject ToastService toastService


<EditForm Model="estudiante" OnValidSubmit="Modificar" FormName="editarEstudiante" method="post">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">EDITAR DATOS DEL ESTUDIANTE</h5>
            </div>

            <div class="card-body">
                <div class="mb-4">
                    <label class="form-label">Id</label>
                    <InputNumber class="form-control" @bind-Value="estudiante.EstudianteId" readonly></InputNumber>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="estudiante.Nombre"></InputText>
                    <ValidationMessage For="@(()=> estudiante.Nombre)"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fecha de nacimiento</label>
                    <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento"></InputDate>
                    <ValidationMessage For="@(()=> estudiante.FechaNacimiento)"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Direccion</label>
                    <InputText class="form-control" @bind-Value="estudiante.Direccion"></InputText>
                    <ValidationMessage For="@(()=> estudiante.Direccion)"/>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="estudiante.Email"></InputText>
                    <ValidationMessage For="@(()=> estudiante.Email)"/>
                </div>
            </div>

            <div class="card-footer text-center mt-2">
                <a href="/Estudiante/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span>Volver</a>
                <button type="submit" class="btn btn-success bi bi-floppy">Guardar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="Modal" data-bs-target="#ModalEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="ModalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalEliminar">¿Esta seguro que desea eliminar el libro?</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label class="form-label">Al eliminar, el estudiante se borrara permanentemente</label>
            </div>
            <div class="modal-footer">
                <a href="/Prestamo/Index" class="btn btn-secondary">Volver</a>
                <button type="button" class="btn btn-danger bi bi-trash" @onclick="Eliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code{
    [Parameter]
    public int EstudianteId{get; set;}
    public Estudiante estudiante{get; set;} = new Estudiante();
    public List<Estudiante> listaEstudiantes = [];

    protected override async Task OnInitializedAsync()
    { 
        estudiante = await estudianteServices.Buscar(EstudianteId) ?? new Estudiante();
        listaEstudiantes = await estudianteServices.GetList(l => l.EstudianteId > 0);
    }

    public async Task Modificar()
    {
        var modificado = await estudianteServices.Modificar(estudiante);

        if (modificado)
        {
            navigation.NavigateTo("/Estudiante/Index");
        }
        else
        {
            toastService.ShowError("Error al guardar los cambios");
        }
    }

    public async Task Eliminar()
    {
        var eliminado =  await estudianteServices.Eliminar(estudiante.EstudianteId);

        if (eliminado)
        {
            navigation.NavigateTo("/Estudiante/Index");
        }
        else
        {
            toastService.ShowError("Error al eliminar el estudiante");
        }
    }
}